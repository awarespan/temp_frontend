# AWARESPAN Volunteer Portal — Environment Configuration Template
# DO NOT COMMIT CREDENTIALS OR REAL SECRETS TO REPOSITORY

# Raspberry Pi Edge Node Hostname or IP Address
# (e.g. 192.168.1.50 on local Wi-Fi, or 10.42.0.1 via Pi USB-C Ethernet Gadget)
VITE_PI_HOST=192.168.1.50

# Raspberry Pi Node Runtime Port
# Defaults to 8766 (matches RUNTIME_PORT in node-backend/shared/config/settings.py)
VITE_PI_PORT=8766

# Transport Security (Set true for wss:// and https:// in production)
VITE_PI_USE_SSL=false

# Authoritative Raspberry Pi Node Identifier
VITE_PI_NODE_ID=sip-pi-001

# Development / Mock Mode
# Set to 'true' for local simulation without physical Raspberry Pi hardware.
# Set to 'false' to communicate with live Raspberry Pi WebSocket ingest.
VITE_MOCK_MODE=true
